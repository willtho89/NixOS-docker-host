# Database
POSTGRES_DB=librarysync
POSTGRES_USER=librarysync
POSTGRES_PASSWORD=${LIBRARYSYNC_POSTGRES_PASSWORD}
DATABASE_URL=postgresql+psycopg://librarysync:${LIBRARYSYNC_POSTGRES_PASSWORD}@librarysync-db:5432/librarysync

# App
LIBRARYSYNC_SECRET_KEY=${LIBRARYSYNC_SECRET_KEY}
LIBRARYSYNC_ADMIN_API_KEY=${LIBRARYSYNC_ADMIN_API_KEY}
LIBRARYSYNC_BASE_URL=https://${LIBRARYSYNC_HOSTNAME}
LOG_LEVEL=INFO
HISTORY_LOOKBACK_DAYS=-1
LIBRARYSYNC_JWT_ACCESS_TOKEN_MINUTES=43200
LIBRARYSYNC_JWT_ALGORITHM=HS256
LIBRARYSYNC_ALLOW_REGISTRATION=true
LIBRARYSYNC_MAX_USERS=20

# OAuth
TRAKT_CLIENT_ID=${LIBRARYSYNC_TRAKT_CLIENT_ID}
TRAKT_CLIENT_SECRET=${LIBRARYSYNC_TRAKT_CLIENT_SECRET}
SIMKL_CLIENT_ID=${LIBRARYSYNC_SIMKL_CLIENT_ID}
SIMKL_CLIENT_SECRET=${LIBRARYSYNC_SIMKL_CLIENT_SECRET}
ANILIST_CLIENT_ID=${LIBRARYSYNC_ANILIST_CLIENT_ID}
ANILIST_CLIENT_SECRET=${LIBRARYSYNC_ANILIST_CLIENT_SECRET}

# Worker modes
LIBRARYSYNC_WORKER_MODES=all
LIBRARYSYNC_WORKER_OUTBOX_CONCURRENCY=1
LIBRARYSYNC_WORKER_METADATA_CONCURRENCY=1
LIBRARYSYNC_WORKER_QUICK_IMPORT_CONCURRENCY=1
LIBRARYSYNC_WORKER_IMPORT_ALL_CONCURRENCY=1

# Rate limits (per user, per provider, per minute)
LIBRARYSYNC_TRAKT_RATE_LIMIT_PER_MINUTE=100
LIBRARYSYNC_SIMKL_RATE_LIMIT_PER_MINUTE=100
LIBRARYSYNC_LETTERBOXD_RATE_LIMIT_PER_MINUTE=100
LIBRARYSYNC_STREMIO_RATE_LIMIT_PER_MINUTE=100
