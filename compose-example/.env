CACHE_WARMUP_UUIDS=REDACTED_USE_SOPS
CF_API_TOKEN=REDACTED_USE_SOPS
COMET_DEBRIDIO_API_KEY=REDACTED_USE_SOPS
COMET_TORBOX_API_KEY=REDACTED_USE_SOPS
DASHBOARD_ADMIN_PASSWORD=REDACTED_USE_SOPS
