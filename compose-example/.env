# Minimal Docker stack configuration for the active services in this repo.

TZ=Europe/Berlin

DOCKER_DIR=/srv/docker
DOCKER_DATA_DIR=${DOCKER_DIR}/data
DOCKER_APP_DIR=${DOCKER_DIR}/apps

PUID=1100
PGID=1100

COMPOSE_PROFILES="required,aiostreams,aiometadata,syncribullet,wg-easy,nzbdav,adguard,warp,librarysync,librespeed,comet,zilean,stremthru,jackettio,jackett,nzbhydra2"

DOMAIN=__DOMAIN__
LETSENCRYPT_EMAIL=REDACTED_USE_SOPS
TRUSTED_IPS=172.16.0.0/12
LE_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory

# Secret values are injected by NixOS from sops at runtime.
ADMIN_USERNAME=REDACTED_USE_SOPS
ADMIN_PASSWORD=REDACTED_USE_SOPS
AIOSTREAMS_AUTH=REDACTED_USE_SOPS
AIOSTREAMS_AUTH_ADMINS=REDACTED_USE_SOPS
